DATABASE_URL=postgresql://postgres:postgres@localhost:51359/main?schema=public
SENTRY_SUPPRESS_TURBOPACK_WARNING=1
NEXT_PUBLIC_HOST_URL=http://localhost:3000
VALKEY_URL=redis://localhost:55791
ELASTICSEARCH_URL=http://localhost:42601
S3_ENDPOINT=http://localhost:51199
S3_REGION=garage
S3_BUCKET_NAME=sprout-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PUBLIC_MEDIA_BASE_URL=http://sprout-media.web.garage.localhost:21693

# SproutOS sign-in. In development these point at the local stub under /dev-login/sproutos,
# so the real authorization-code + PKCE + userinfo flow runs end to end without a live
# provider. Replace all five with the real endpoints when they exist; the sign-in button and
# the routes stay hidden until every one is set.
SPROUTOS_CLIENT_ID=dev-client
SPROUTOS_CLIENT_SECRET=dev-secret
SPROUTOS_AUTHORIZE_URL=http://localhost:3000/dev-login/sproutos
SPROUTOS_TOKEN_URL=http://localhost:3000/dev-login/sproutos/token
SPROUTOS_USERINFO_URL=http://localhost:3000/dev-login/sproutos/userinfo
SPROUTOS_INTROSPECT_URL=http://localhost:3000/dev-login/sproutos/introspect
SPROUTOS_SCOPES=openid email profile github:identity

# Contribution attribution and accepted-business provisioning. The GitHub private key may use
# literal `\n` escapes so it remains a single env-file line. The App needs administration write,
# Actions write, checks read, pull requests read, metadata read, and the pull_request webhook event.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
SPROUTOS_API_URL=https://api.sproutos.me
SPROUTOS_SERVICE_TOKEN=
SPROUTOS_ORG_SLUG=
SPROUTOS_REGION=
SPROUTBIZ_API_URL=http://localhost:3000/api/v1
SPROUTBIZ_BUSINESS_DOMAIN_SUFFIX=sproutos.biz
SPROUTBIZ_IDEA_COMMUNITY=saasideas

# Stripe, for the donate button. Donations are disabled when these are unset.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=

# Media uploads (post images, avatars, banners, community artwork). Off unless "true".
# The server rejects every media endpoint with 503 while this is off; the client flag below
# only hides the buttons.
MEDIA_UPLOADS_ENABLED=false
VITE_MEDIA_UPLOADS_ENABLED=false

# Slack, for the Earn Money view-count reminders. The bullground worker posts to
# SLACK_UNBLOCK_CHANNEL via chat.postMessage and mentions SLACK_OWNER_USER_ID. Reminders are
# skipped with a log line, not an error, when these are unset.
SLACK_BOT_TOKEN=
SLACK_UNBLOCK_CHANNEL=
SLACK_REVIEW_CHANNEL=
SLACK_OPS_CHANNEL=
SLACK_OWNER_USER_ID=
