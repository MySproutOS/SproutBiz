DATABASE_URL=postgresql://postgres:postgres@localhost:51359/main?schema=public
SENTRY_SUPPRESS_TURBOPACK_WARNING=1
NEXT_PUBLIC_HOST_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VALKEY_URL=redis://localhost:55791
ELASTICSEARCH_URL=http://localhost:42601
S3_ENDPOINT=http://localhost:51199
S3_REGION=garage
S3_BUCKET_NAME=sprout-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PUBLIC_MEDIA_BASE_URL=http://sprout-media.web.garage.localhost:21693

# SproutOS sign-in. In development these point at the local stub under /dev-login/sproutos,
# so the real authorization-code + PKCE + userinfo flow runs end to end without a live
# provider. Replace all five with the real endpoints when they exist; the sign-in button and
# the routes stay hidden until every one is set.
SPROUTOS_CLIENT_ID=dev-client
SPROUTOS_CLIENT_SECRET=dev-secret
SPROUTOS_AUTHORIZE_URL=http://localhost:3000/dev-login/sproutos
SPROUTOS_TOKEN_URL=http://localhost:3000/dev-login/sproutos/token
SPROUTOS_USERINFO_URL=http://localhost:3000/dev-login/sproutos/userinfo
SPROUTOS_SCOPES=openid email profile

# Stripe, for the donate button. Donations are disabled when these are unset.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
