# Runtime environment for the production containers, deployed by hand to
# /opt/forum/.env.production (chmod 600). Never committed with real values.
#
# No quotes: compose's env_file parser is not a shell, so FOO="bar" yields literal quotes.
# `docker compose restart` does NOT re-read this file -- use `up -d --force-recreate`.

NODE_ENV=production

DATABASE_URL=postgres://forum:REPLACE_ME@postgres:5432/main
VALKEY_URL=redis://:REPLACE_ME@valkey:6379
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=REPLACE_ME

NEXT_PUBLIC_HOST_URL=https://forum.sproutos.me
# Where the website fetches SPA index.html from, server-side.
SPA_ORIGIN=https://static.forum.sproutos.me


# SproutOS sign-in. The button stays hidden until all five are set.
SPROUTOS_CLIENT_ID=
SPROUTOS_CLIENT_SECRET=
SPROUTOS_AUTHORIZE_URL=
SPROUTOS_TOKEN_URL=
SPROUTOS_USERINFO_URL=
SPROUTOS_SCOPES=openid email profile

# Object storage for user-uploaded media. Inert while MEDIA_UPLOADS_ENABLED is false, which it
# is -- and Garage has been shut down, so these currently point at nothing. Turning uploads back
# on means pointing them at real storage first: most likely the same S3 account that already
# serves the static assets, rather than standing Garage back up on the OVH box.
S3_ENDPOINT=
S3_REGION=garage
S3_BUCKET_NAME=media.forum
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PUBLIC_MEDIA_BASE_URL=https://media.forum.sproutos.me

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=

# Media uploads. Off until Garage is reachable in production and the moderation story for
# user-supplied images is settled. Set BOTH to "true" to enable.
MEDIA_UPLOADS_ENABLED=false
VITE_MEDIA_UPLOADS_ENABLED=false
