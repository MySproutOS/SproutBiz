# Runtime environment for the production containers. This file is the public shape;
# the filled-in copy lives at the repo root as .env.production (gitignored) and is
# deployed to /opt/sproutbiz/.env.production (chmod 600) by bin/deploy/sync-env.sh.
# Never committed with real values.
#
# No quotes: compose's env_file parser is not a shell, so FOO="bar" yields literal quotes.
# `docker compose restart` does NOT re-read this file -- use `up -d --force-recreate`.

NODE_ENV=production

DATABASE_URL=postgres://forum:REPLACE_ME@postgres:5432/main
VALKEY_URL=redis://:REPLACE_ME@valkey:6379
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=REPLACE_ME

NEXT_PUBLIC_HOST_URL=https://sproutos.biz
NEXT_PUBLIC_SPROUTOS_URL=https://sproutos.me
# Where the website fetches SPA index.html from, server-side.
SPA_ORIGIN=https://static.forum.sproutos.me


# SproutOS sign-in. The button stays hidden until all six are set.
#
# Two hosts, deliberately: the consent screen is a page on the website, the rest is the API.
# Userinfo supplies the stable SproutOS subject plus the linked GitHub identity used to attribute
# code contributions. Introspection remains the source of token validity and granted scopes.
SPROUTOS_CLIENT_ID=
SPROUTOS_CLIENT_SECRET=
SPROUTOS_AUTHORIZE_URL=https://sproutos.me/oauth/authorize
SPROUTOS_TOKEN_URL=https://api.sproutos.me/v1/oauth/token
SPROUTOS_USERINFO_URL=https://api.sproutos.me/v1/oauth/userinfo
SPROUTOS_INTROSPECT_URL=https://api.sproutos.me/v1/oauth/introspect
SPROUTOS_SCOPES=openid email profile github:identity

# SproutOS provisioning. The service token should be restricted to:
# org:read project:create project:read project:update credential:write
SPROUTOS_API_URL=https://api.sproutos.me
SPROUTOS_ORG_SLUG=
SPROUTOS_REGION=
SPROUTOS_SERVICE_TOKEN=

# GitHub App used to aggregate contribution PRs and provision repositories from the public
# business template. Store the PEM with literal \n sequences; the worker normalizes them.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Every accepted idea gets a dedicated community and managed SproutOS business hostname.
SPROUTBIZ_IDEA_COMMUNITY=saasideas
SPROUTBIZ_BUSINESS_DOMAIN_SUFFIX=sproutos.biz

# Object storage for user-uploaded media. Inert while MEDIA_UPLOADS_ENABLED is false, which it
# is -- and Garage has been shut down, so these currently point at nothing. Turning uploads back
# on means pointing them at real storage first: most likely the same S3 account that already
# serves the static assets, rather than standing Garage back up on the OVH box.
S3_ENDPOINT=
S3_REGION=garage
S3_BUCKET_NAME=media.forum
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PUBLIC_MEDIA_BASE_URL=https://media.forum.sproutos.me

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=

# Media uploads. Off until Garage is reachable in production and the moderation story for
# user-supplied images is settled. Set BOTH to "true" to enable.
MEDIA_UPLOADS_ENABLED=false
VITE_MEDIA_UPLOADS_ENABLED=false

# Slack review and operations routing. The website posts pending ideas to the review channel;
# the worker posts provisioning/store follow-ups to the operations channel and existing Earn
# Money reminders to the unblock channel. Messages mention SLACK_OWNER_USER_ID when relevant.
SLACK_BOT_TOKEN=
SLACK_REVIEW_CHANNEL=
SLACK_OPS_CHANNEL=
SLACK_UNBLOCK_CHANNEL=
SLACK_OWNER_USER_ID=

# Bullground gets a graceful drain window just below the container stop timeout.
SHUTDOWN_TIMEOUT_MS=570000
